# Copy to .env and fill in. Variable names only, never real values here.

# Which PriceSource the app uses: "fallback" (yfinance) or "bloomberg" (blpapi)
PRICE_SOURCE=fallback

# Bloomberg Desktop / Server API (only if PRICE_SOURCE=bloomberg)
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194

# Dashboard
DASH_PORT=8050
REFRESH_SECONDS=60
